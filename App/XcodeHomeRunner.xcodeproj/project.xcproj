          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Configurations",
      "children": [
        { "path": "Signing.xcconfig" },
      ],
    }, {
      "kind": "group",
      "path": "../Scripts",
      "children": [
        { "path": "install-github-runner.sh", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
        { "path": "enable-hosted-runner.sh", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
        { "path": "cleanup-runner-temp.sh", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
        { "path": "lock-host-storage.py", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
        { "path": "stop-runner-service.py", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
        { "path": "cleanup-runner-temp.py", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
        { "path": "install-runner-host.sh", "target-membership": [ "XcodeHomeRunner/copy/Copy Host Setup" ] },
      ],
    },
    { "kind": "folder", "path": "xcode-runner", "target-membership": [ "xcode-runner" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/XcodeHomeRunner.app", "id": "AB15079E3097162D00B300A6", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/xcode-runner", "id": "AB150B1430976A8A00B300A6", "type": "compiled.mach-o.executable", "index": false, "target-membership": [ { "build-phase": "XcodeHomeRunner/copy/Embed Command Line Tool", "code-sign-on-copy": true } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "XcodeHomeRunner",
      "id": "AB15079D3097162D00B300A6",
      "product": "Products/XcodeHomeRunner.app",
      "product-type": "application",
      "dependencies": [
        "xcode-runner",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Copy Host Setup",
          "bundle-base-path": "resources-directory",
          "relative-path": "HostSetup",
        }, {
          "kind": "copy",
          "name": "Embed Command Line Tool",
          "bundle-base-path": "contents-directory",
          "relative-path": "Helpers",
        },
      ],
      "package-product-members": [
        {
          "package": "..",
          "product-name": "XcodeRunnerHostApp",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_APP_SANDBOX": "NO",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "XcodeHomeRunner/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "XcodeHomeRunner",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.developer-tools",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "Pairs this Mac with your other Macs on the local network so that one of them can manage their runners.",
        "INFOPLIST_KEY_NSPrincipalClass": "NSApplication",
        "INFOPLIST_KEY_NSRemovableVolumesUsageDescription": "Runs your build and test jobs from storage you selected.",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/../Frameworks",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "0.0.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "lynnpd.xcodehomerunner",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "xcode-runner",
      "id": "AB150B1330976A8A00B300A6",
      "product": "Products/xcode-runner",
      "product-type": "tool",
      "build-phases": [
        "compile-sources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "package": "..",
          "product-name": "XcodeRunnerCLI",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ARCHS": "arm64",
        "CODE_SIGN_STYLE": "Automatic",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "lynnpd.xcodehomerunner.xcode-runner",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "macosx",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++20",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
  },
  "last-upgrade": "27.2",
